{
  "_documentation": {
    "purpose": "Configuration for the 3D multi-patch elasticity examples.",
    "notes": [
      "geometry typically points to a multi-patch XML file together with the chosen multipatch_id.",
      "geometry_spline and solution_spline control the patch-local spline spaces.",
      "multipatch contains the global loads and boundary conditions used by iganet_lin_elasticity_3D_multipatch.cxx."
    ]
  },
  "simulation": {
    "max_epoch": 200,
    "min_loss": 1e-06,
    "supervised_learning": false,
    "device": "cpu"
  },
  "reference_simulation": {
    "run_gs_ref_sim": false,
    "run_coll_ref_sim": false,
    "nr_ctrl_pts_ref": 64,
    "degree_ref": 4
  },
  "material": {
    "young_modulus": 210.0,
    "poisson_ratio": 0.25
  },
  "geometry": {
    "mode": "xml",
    "multipatch_xml_path": "filedata/bone_simplified.xml",
    "multipatch_id": 0,
    "boundary_label": "BID1"
  },
  "geometry_spline": {
    "nr_ctrl_pts": 6,
    "degree": 3
  },
  "solution_spline": {
    "nr_ctrl_pts": 6,
    "degree": 3
  },
  "multipatch": {
    "learning_rate": 0.01,
    "dirichlet_weight": 100000.0,
    "body_force": [
      0.0,
      0.0,
      -10.0
    ],
    "boundary_conditions": {
      "diri_sides": [
        [
          1,
          0.0,
          0.0,
          0.0
        ]
      ],
      "force_sides": []
    }
  }
}
