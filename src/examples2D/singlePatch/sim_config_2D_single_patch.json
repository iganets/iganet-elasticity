{
  "_documentation": {
    "purpose": "Configuration for the 2D single-patch elasticity example.",
    "notes": [
      "solution_spline defines the displacement spline that IgANet optimizes.",
      "single_patch_2D contains body force and boundary conditions for the physical problem.",
      "reference_simulation controls optional comparison runs such as G+Smo or standard collocation."
    ]
  },
  "optimizer": {
    "type": "lbfgs"
  },
  "simulation": {
    "device": "cpu",
    "max_epoch": 5,
    "min_loss": 1e-06,
    "bc_weight": 100.0,
    "strong_dirichlet": true,
    "supervised_learning": false
  },
  "reference_simulation": {
    "run_gs_ref_sim": false,
    "run_coll_ref_sim": false,
    "nr_ctrl_pts_ref": 64,
    "degree_ref": 4
  },
  "material": {
    "young_modulus": 210.0,
    "poisson_ratio": 0.25
  },
  "solution_spline": {
    "nr_ctrl_pts": 8,
    "degree": 4
  },
  "single_patch_2D": {
    "body_force": [
      0.0,
      0.0
    ],
    "boundary_conditions": {
      "force_sides": [],
      "diri_sides": [
        [
          1,
          0.0,
          0.0
        ],
        [
          2,
          1.0,
          0.0
        ]
      ],
      "tfbc_sides": [
        3,
        4
      ]
    }
  }
}
