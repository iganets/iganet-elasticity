    "run_coll_ref_sim": false,
    "nr_ctrl_pts_ref": 64,
    "degree_ref": 4
  },
  "material": {
    "young_modulus": 210.0,
    "poisson_ratio": 0.25
  },
  "geometry_spline": {
    "nr_ctrl_pts": 8,
    "degree": 4
  },
